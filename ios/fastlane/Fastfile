# TestFlight delivery. CI runs `make ios-testflight` on every push to main
# (.github/workflows/ios.yml). The lane reads from the environment:
#
#   APPLE_TEAM_ID   Apple Developer team ID
#   ASC_KEY_ID      App Store Connect API key ID
#   ASC_ISSUER_ID   its issuer ID
#   ASC_KEY_P8      content of the AuthKey_<id>.p8 file
#
# The key needs the Admin role: xcodebuild signs with it and lets Apple manage the
# distribution certificate and profile, so there is no certificate repository.
require "tempfile"

opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Archive a Release build and upload it to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_content = ENV.fetch("ASC_KEY_P8")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_content: key_content)
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1

    Tempfile.create(["AuthKey", ".p8"]) do |key_file|
      key_file.write(key_content)
      key_file.flush
      signing = "-allowProvisioningUpdates -authenticationKeyPath #{key_file.path} " \
                "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"
      build_app(
        project: "Pulse.xcodeproj",
        scheme: "Pulse",
        configuration: "Release",
        export_method: "app-store",
        export_team_id: team_id,
        output_directory: ".build/testflight",
        xcargs: "#{signing} -skipPackagePluginValidation " \
                "DEVELOPMENT_TEAM=#{team_id} CURRENT_PROJECT_VERSION=#{build_number}",
        export_xcargs: signing
      )
    end

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
