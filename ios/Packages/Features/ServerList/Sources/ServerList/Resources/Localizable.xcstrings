{
  "sourceLanguage" : "en",
  "strings" : {
    "A different fingerprint means another machine answered. Check the address and the network." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другой отпечаток значит, что ответила другая машина. Проверьте адрес и сеть."
          }
        }
      }
    },
    "A key login needs passwordless sudo. Log in with the password instead." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для входа по ключу нужен sudo без пароля. Войдите по паролю."
