      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт"
          }
        }
      }
    },
    "Pulse supports Ubuntu 22.04, 24.04 and Debian 12. The agent may work here, without guarantees." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse поддерживает Ubuntu 22.04, 24.04 и Debian 12. Здесь агент может работать, но без гарантий."
          }
        }
      }
    },
    "Run ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub on the server. Go on only if the fingerprint is exactly the same." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните на сервере ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub. Продолжайте, только если отпечаток точно совпадает."
          }
        }
      }
    },
    "Run sudo pulse-agent pair on the server. Go on only if its fingerprint is exactly the same." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните на сервере sudo pulse-agent pair. Продолжайте, только если fingerprint совпадает полностью."
          }
        }
      }
    },
    "Runs as" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запуск от"
          }
        }
      }
    },
    "SSH port" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт SSH"
          }
        }
      }
    },
    "Scan QR code" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканировать QR-код"
