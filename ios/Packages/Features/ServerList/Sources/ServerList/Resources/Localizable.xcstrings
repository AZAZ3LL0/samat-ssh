        }
      }
    },
    "System" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Система"
          }
        }
      }
    },
    "The agent listens on port 7443 unless its config.yaml says otherwise." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент слушает порт 7443, если в его config.yaml не указан другой."
          }
        }
      }
    },
    "The code from pulse-agent pair works once, for 10 minutes." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код из pulse-agent pair одноразовый и действует 10 минут."
          }
        }
      }
    },
    "The code is wrong, expired or already used. Run pulse-agent pair again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код неверный, просрочен или уже использован. Выполните pulse-agent pair ещё раз."
          }
        }
      }
    },
    "The connection dropped. Try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение оборвалось. Попробуйте ещё раз."
          }
        }
      }
    },
    "The password or key is used once for this install and never saved. The app then logs in with its own key." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль или ключ используется один раз для установки и не сохраняется. Дальше приложение входит своим ключом."
          }
        }
      }
    },
    "The private key cannot be read, or the passphrase is wrong." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приватный ключ не читается или пароль ключа неверен."
          }
        }
      }
    },
    "The server did not answer in time." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не ответил вовремя."
          }
        }
      }
    },
    "The server does not answer on this port." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не отвечает на этом порту."
          }
        }
      }
    },
    "The server paired, but the app could not save it. Try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер привязан, но приложение не смогло его сохранить. Попробуйте ещё раз."
          }
        }
      }
    },
    "The server presented another host key. Start over." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер предъявил другой ключ хоста. Начните заново."
          }
        }
      }
    },
    "The server refused the user, password or key." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отклонил пользователя, пароль или ключ."
          }
        }
      }
    },
    "They differ" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отличаются"
          }
        }
      }
    },
    "This is not a pairing link from pulse-agent pair." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не ссылка привязки из pulse-agent pair."
          }
        }
      }
    },
    "User" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользователь"
          }
        }
      }
    },
    "pulse-agent has no build for %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У pulse-agent нет сборки для %@."
          }
        }
      }
    },
    "pulse-agent pair printed something unexpected. Update the agent." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pulse-agent pair вывел неожиданный ответ. Обновите агента."
          }
        }
      }
    },
    "sudo refused the password. The user needs sudo rights." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sudo отклонил пароль. Пользователю нужны права sudo."
          }
        }
      }
