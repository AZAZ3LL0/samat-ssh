            "value" : "Порт"
          }
        }
      }
    },
    "Run sudo pulse-agent pair on the server. Go on only if its fingerprint is exactly the same." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните на сервере sudo pulse-agent pair. Продолжайте, только если fingerprint совпадает полностью."
          }
        }
      }
    },
    "The agent listens on port 7443 unless its config.yaml says otherwise." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент слушает порт 7443, если в его config.yaml не указан другой."
          }
        }
      }
    },
    "The code from pulse-agent pair works once, for 10 minutes." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код из pulse-agent pair одноразовый и действует 10 минут."
          }
        }
      }
    },
    "The code is wrong, expired or already used. Run pulse-agent pair again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код неверный, просрочен или уже использован. Выполните pulse-agent pair ещё раз."
          }
        }
      }
    },
    "The server paired, but the app could not save it. Try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер привязан, но приложение не смогло его сохранить. Попробуйте ещё раз."
